# =========================================================================
# FILEFUSION PRODUCTION .GITIGNORE
# =========================================================================

# Dependencies
/node_modules
/vendor
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secret Credentials
.env
.env.backup
.env.production
.env.local
.env.*.local
/auth.json

# Storage, Uploads & Runtime Files
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/tmpfiles/*
!/tmpfiles/.gitignore
/uploads/*
!/uploads/.gitignore

# Public Temporary & Dev Assets
/public/hot
/public/storage
/public/Browsershot/*
!/public/Browsershot/.gitignore
/public/%SystemDrive%

# Testing & Local Development Files
/.phpunit.cache
/.phpunit.result.cache
/antigravity_testfiles
/agent_memory
/agent_plan
*.test.php
test_*.php

# Archives, Dumps & Backups
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.sql
*.sqlite

# IDE & OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
Homestead.json
Homestead.yaml
