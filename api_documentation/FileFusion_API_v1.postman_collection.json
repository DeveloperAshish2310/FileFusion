              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Developer\",\n  \"email\": \"jane.developer@example.com\",\n  \"username\": \"janedev\",\n  \"password\": \"SecurePass#2026\",\n  \"role\": \"pro_user\",\n  \"storage_quota_gb\": 100\n}"
            },
            "url": "{{base_url}}/admin/users"
          }
        }
      ]
    }
  ]
}
