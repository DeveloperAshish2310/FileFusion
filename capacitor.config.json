{
  "appId": "io.filefusion.app",
  "appName": "FileFusion",
  "webDir": "public",
  "server": {
    "url": "http://10.0.2.2:8000",
    "cleartext": true,
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_filefusion",
      "iconColor": "#6366f1"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
