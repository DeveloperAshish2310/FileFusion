{
  "appId": "io.filefusion.app",
  "appName": "FileFusion",
  "webDir": "public_mobile",
  "server": {
    "url": "http://192.168.1.101/filefusion/panel",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_filefusion",
      "iconColor": "#6366f1"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}