# =========================================================================
# FileFusion — Enterprise Application Environment Configuration (.env.example)
# =========================================================================

APP_NAME="FileFusion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -------------------------------------------------------------------------
# Logging Configuration
# -------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB recommended)
# -------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filefusion_db
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------------------------
# Master Envelope Encryption & Key Rotation
# -------------------------------------------------------------------------
# Master key used for envelope AES-256-CBC cipher generation on files & credentials
FILE_ENCRYPTION_KEY=
FILE_KEY_VERSION=v1

# Comma-separated list of previous keys for zero-downtime key rotation
APP_PREVIOUS_KEYS=
FILE_PREVIOUS_KEYS=

# -------------------------------------------------------------------------
# Session & Cache Storage
# -------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# -------------------------------------------------------------------------
# File System & Upload Storage Limits
# -------------------------------------------------------------------------
FILESYSTEM_DISK=public
MAX_UPLOAD_SIZE_MB=500
DEFAULT_STORAGE_QUOTA_GB=25

# -------------------------------------------------------------------------
# Two-Factor Authentication (2FA) & Security
# -------------------------------------------------------------------------
TWO_FACTOR_ISSUER="FileFusion"
DEFAULT_VAULT_TIMEOUT=1800
DEFAULT_PASSWORD_REVEAL_TIMEOUT=900

# -------------------------------------------------------------------------
# Developer REST API & Personal Access Tokens (PAT)
# -------------------------------------------------------------------------
API_DEFAULT_RATE_LIMIT=60
API_TOKEN_LIFETIME_DAYS=365

# -------------------------------------------------------------------------
# Backup & Offsite Disaster Recovery Storage
# -------------------------------------------------------------------------
BACKUP_STORAGE_DISK=local
BACKUP_ENCRYPTION_ENABLED=true

# Remote Offsite Backup Target (optional: ftp, sftp, s3)
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DISK=sftp
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_USERNAME=
BACKUP_REMOTE_PASSWORD=
BACKUP_REMOTE_PATH=/backups/filefusion

# -------------------------------------------------------------------------
# Mail Configuration (Required for Email OTP 2FA & Notifications)
# -------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@filefusion.local"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------------
# Redis (Optional: for high-performance queues and cache)
# -------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------------------------
# Amazon S3 / Object Storage (Optional)
# -------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------------------------
# Frontend Assets (Vite)
# -------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------------------
# Web Push (VAPID) & Firebase Cloud Messaging (FCM)
# -------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@filefusion.local"

FCM_SERVER_KEY=
FCM_SENDER_ID=

# -------------------------------------------------------------------------
# Google Firebase App Configuration (Change easily anytime)
# -------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

VITE_FIREBASE_API_KEY="${FIREBASE_API_KEY}"
VITE_FIREBASE_AUTH_DOMAIN="${FIREBASE_AUTH_DOMAIN}"
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_STORAGE_BUCKET="${FIREBASE_STORAGE_BUCKET}"
VITE_FIREBASE_MESSAGING_SENDER_ID="${FIREBASE_MESSAGING_SENDER_ID}"
VITE_FIREBASE_APP_ID="${FIREBASE_APP_ID}"
VITE_FIREBASE_MEASUREMENT_ID="${FIREBASE_MEASUREMENT_ID}"

# -------------------------------------------------------------------------
# Background Cron Execution Token (Optional)
# -------------------------------------------------------------------------
CRON_SECRET=
